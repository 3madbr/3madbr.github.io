#!/usr/bin/env bash
# Preview the site locally at http://localhost:4000 (auto-reloads on save).
set -e
export LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8   # .bib contains non-ASCII names
cd "$(dirname "$0")/.."
bundle install --quiet
bundle exec jekyll serve --livereload --config _config.yml,_config_dev.yml "$@"
